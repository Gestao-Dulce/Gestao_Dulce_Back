# ─────────────────────────────────────────────────────────────
#  Gestão Dulce — Backend  |  Variáveis de Ambiente
#  Copie este arquivo como .env (desenvolvimento local) ou
#  configure cada variável diretamente no painel do Render.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL="https://<seu-projeto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# ── JWT ──────────────────────────────────────────────────────
# Use um valor longo e aleatório em produção
JWT_SECRET="<segredo-jwt-longo-e-aleatorio>"
JWT_EXPIRES_IN="24h"

# ── Servidor ─────────────────────────────────────────────────
# PORT é injetado automaticamente pelo Render — não precisa definir em produção
PORT=3001
NODE_ENV="development"

# ── CORS ─────────────────────────────────────────────────────
# Lista de origens separadas por vírgula
# Ex. produção: https://seu-app.vercel.app
# Ex. dev:      http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── Admin ────────────────────────────────────────────────────
ADMIN_DEFAULT_PASSWORD="<senha-do-admin>"

# ── Google Gemini AI ─────────────────────────────────────────
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<sua-chave-gemini>"
